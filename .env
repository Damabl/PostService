# Сервер
SERVER_PORT=8082

# База данных (Master)
DB_MASTER_URL=jdbc:postgresql://localhost:5432/postgres
DB_MASTER_USER=user
DB_MASTER_PASSWORD=password

# База данных (Slave)
DB_SLAVE_URL=jdbc:postgresql://localhost:5433/postgres
DB_SLAVE_USER=user
DB_SLAVE_PASSWORD=password

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_LIKE_TOPIC=like-events
KAFKA_COMMENT_TOPIC=comment-events
KAFKA_POST_TOPIC=post-events

# MinIO
MINIO_BUCKET=postimage
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=user
MINIO_SECRET_KEY=Damir2005

# Eureka
EUREKA_SERVER=http://localhost:8761/eureka/

# Circuit Breaker
CATEGORY_SERVICE_FAILURE_RATE=50
CATEGORY_SERVICE_WAIT_DURATION=10s
CATEGORY_SERVICE_HALF_OPEN_CALLS=2
CATEGORY_SERVICE_SLIDING_WINDOW=5

# Изображения
IMAGE_URL=http://localhost:8081/images/
